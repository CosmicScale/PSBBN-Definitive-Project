#!/bin/bash
if [[ "${1:-}" == "--psbbn-shim-ok" ]]; then
    exit 0
fi
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$here/../lib.sh"
args=()
for arg in "$@"; do
    case "$arg" in
        -l|--lazy) continue ;;
        --) continue ;;
        *) args+=("$(psbbn_rewrite_device "$arg")") ;;
    esac
done
real="${PSBBN_REAL_UMOUNT:-/sbin/umount}"
if [[ ${#args[@]} -eq 0 ]]; then
    exit 0
fi
exec "$real" "${args[@]}"
