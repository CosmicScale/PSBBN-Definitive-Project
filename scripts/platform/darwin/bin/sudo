#!/bin/bash
# The installer calls `sudo`, never /usr/bin/sudo.
# Shims run without a password. Missing commands fail without prompting.
# Everything else goes to the real sudo with PATH preserved.
if [[ "${1:-}" == "--psbbn-shim-ok" ]]; then
    exit 0
fi
here=${0%/*}
[[ "$here" == "$0" ]] && here=.
here=$(cd "$here" && pwd)
# shellcheck disable=SC1091
. "$here/../../load.sh"
cmd="${1:-}"
if [[ -z "$cmd" ]]; then
    echo "usage: sudo command" >&2
    exit 1
fi
shift
if [[ -x "$here/$cmd" ]]; then
    exec "$here/$cmd" "$@"
fi
if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "sudo: $cmd: command not found" >&2
    exit 1
fi
if [[ -n "${PSBBN_REAL_SUDO:-}" ]]; then
    exec "$PSBBN_REAL_SUDO" env PATH="$PATH" "$cmd" "$@"
fi
platform_elevate env PATH="$PATH" "$cmd" "$@"
