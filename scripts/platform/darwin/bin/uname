#!/bin/bash
# uname -m on Apple silicon is arm64. The installer only accepts x86_64 and aarch64.
real="${PSBBN_UNAME:-/usr/bin/uname}"
if [[ "${1:-}" == "--psbbn-shim-ok" ]]; then
    exit 0
fi
if [[ "${1:-}" == "-m" && $# -eq 1 ]]; then
    machine=$("$real" -m)
    if [[ "$machine" == arm64 ]]; then
        printf '%s\n' aarch64
    else
        printf '%s\n' "$machine"
    fi
    exit 0
fi
exec "$real" "$@"
