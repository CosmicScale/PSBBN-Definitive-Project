#!/bin/bash
# A staged partition is a folder on the Mac, so plain df reports the Mac's
# free space for it. Media-Installer checks there is room on __contents for
# a converted movie. For a path inside a staged partition this answers for
# the partition on the PS2 drive instead: its free space less what has been
# staged and not yet written back. Every other path goes to the real df.
if [[ "${1:-}" == "--psbbn-shim-ok" ]]; then
    exit 0
fi
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$here/../../load.sh"

real_df() {
    local dir
    local IFS=:
    for dir in $PATH; do
        [[ "$dir" == "$here" || -z "$dir" ]] && continue
        if [[ -x "$dir/df" ]]; then
            printf '%s\n' "$dir/df"
            return 0
        fi
    done
    printf '%s\n' /bin/df
}

paths=()
for arg in "$@"; do
    [[ "$arg" == -* ]] || paths+=("$arg")
done
row=""
for path in ${paths[@]+"${paths[@]}"}; do
    if found=$(psbbn_stage_find "$path"); then
        row=$found
        break
    fi
done
if [[ -z "$row" ]]; then
    exec "$(real_df)" "$@"
fi
if [[ ${#paths[@]} -ne 1 ]]; then
    echo "df: a staged partition must be the only path" >&2
    exit 1
fi
IFS=$'\t' read -r key kind mnt slice <<< "$row"
state=$(psbbn_mount_state_dir)

# Size and free bytes of the partition as the drive holds it now.
case "$kind" in
    pfs)
        part=$(cat "$state/$key.part" 2>/dev/null)
        out=$(psbbn_pfs_run "$slice" "$(printf 'device %s\nmount %s\ndf\numount\nexit' "$slice" "$part")") || exit 1
        sizes=$(printf '%s\n' "$out" | "$(psbbn_python)" -c '
import re, sys
part = sys.argv[1]
units = {"B": 1, "KiB": 1 << 10, "MiB": 1 << 20, "GiB": 1 << 30, "TiB": 1 << 40}
num = r"(\d+(?:\.\d+)?)(B|KiB|MiB|GiB|TiB)"
for line in sys.stdin:
    m = re.match(r"\s*" + re.escape(part) + r"\s+" + num + r"\s+" + num + r"\s+" + num + r"\s", line)
    if m:
        size, avail = float(m.group(1)) * units[m.group(2)], float(m.group(5)) * units[m.group(6)]
        print(int(size), int(avail))
        raise SystemExit(0)
raise SystemExit(1)
' "$part") || { echo "df: pfsshell did not report $part" >&2; exit 1; }
        ;;
    ext2)
        debugfs=$(psbbn_debugfs_bin) || exit 1
        sizes=$("${debugfs%/*}/dumpe2fs" -h "$slice" 2>/dev/null | awk -F: '
            /^Block count/ { n = $2 + 0 }
            /^Free blocks/ { f = $2 + 0 }
            /^Reserved block count/ { r = $2 + 0 }
            /^Block size/ { b = $2 + 0 }
            END { if (b) printf "%d %d\n", n * b, (f > r ? f - r : 0) * b; else exit 1 }') \
            || { echo "df: cannot read $slice" >&2; exit 1; }
        ;;
    vfat)
        tooldir=$(dirname "$(psbbn_mcopy_bin)") || exit 1
        total=$("$tooldir/minfo" -i "$slice" :: 2>/dev/null | awk -F: '
            /^sector size/ { s = $2 + 0 }
            /^big size/ { n = $2 + 0 }
            END { if (s && n) printf "%d\n", s * n; else exit 1 }') || { echo "df: cannot read $slice" >&2; exit 1; }
        free=$("$tooldir/mdir" -i "$slice" ::/ 2>/dev/null | awk '/bytes free/ { gsub(/[^0-9]/, "", $0); print }')
        [[ -n "$free" ]] || { echo "df: cannot read $slice" >&2; exit 1; }
        sizes="$total $free"
        ;;
    *)
        echo "df: $mnt: unknown stage kind '$kind'" >&2
        exit 1
        ;;
esac

"$(psbbn_python)" - "$mnt" "$state/$key.manifest" "$kind" "$sizes" "$_psbbn_darwin_dir" "$@" << 'PY'
import math, os, sys
mnt, manifest_path, kind, sizes, libdir = sys.argv[1:6]
args = sys.argv[6:]
sys.dont_write_bytecode = True
sys.path.insert(0, libdir)
import manifest as mf

size, avail = (int(x) for x in sizes.split())
# Bytes staged since the snapshot: new and grown files take space, removed
# and shrunk ones give it back.
old = mf.load(manifest_path)
new = mf.scan(mnt)
pending = 0
for rel in set(old) | set(new):
    a, b = old.get(rel), new.get(rel)
    if a == b:
        continue
    if b and b[0] == "f":
        pending += b[1]
    if a and a[0] == "f":
        pending -= a[1]
avail = max(0, min(size, avail - pending))
used = size - avail

unit = 1024
fields = None
posix = False
for arg in args:
    if not arg.startswith("-"):
        continue
    if arg == "-k":
        unit = 1024
    elif arg == "-m":
        unit = 1 << 20
    elif arg == "-P":
        posix = True
    elif arg in ("-Pk", "-kP"):
        posix, unit = True, 1024
    elif arg.startswith("--output="):
        fields = arg.split("=", 1)[1].split(",")
    else:
        sys.stderr.write("df: %s is not supported for a staged partition\n" % arg)
        raise SystemExit(1)

def blocks(n):
    return str(math.ceil(n / unit))

label = "1K-blocks" if unit == 1024 else "1M-blocks"
pcent = "%d%%" % math.ceil(100 * used / size) if size else "-"
source = "ps2:" + os.path.basename(mnt.rstrip("/"))
columns = {
    "source": ("Filesystem", source),
    "size": (label, blocks(size)),
    "used": ("Used", blocks(used)),
    "avail": ("Avail", blocks(avail)),
    "pcent": ("Use%", pcent),
    "target": ("Mounted on", mnt),
}
if fields is None:
    fields = ["source", "size", "used", "avail", "pcent", "target"]
    if posix:
        columns["size"] = ("1024-blocks" if unit == 1024 else "1048576-blocks", blocks(size))
        columns["avail"] = ("Available", blocks(avail))
        columns["pcent"] = ("Capacity", pcent)
for name in fields:
    if name not in columns:
        sys.stderr.write("df: field %s is not supported for a staged partition\n" % name)
        raise SystemExit(1)
print(" ".join(columns[f][0] for f in fields))
print(" ".join(columns[f][1] for f in fields))
PY
