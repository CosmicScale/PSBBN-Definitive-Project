#!/opt/homebrew/bin/python3
"""Write the three-partition APA-Jail MBR the installer pipes to sfdisk.

Geometry follows the installer's sfdisk script: 512-byte sectors, first
partition at LBA 2048. It has not been byte-compared with Linux sfdisk.
Internal disks are refused. External disks are the PS2 drive.
"""
import os
import plistlib
import struct
import subprocess
import sys

def load_sh():
    return os.path.join(os.path.dirname(__file__), "..", "..", "load.sh")

def lib_sh():
    return os.path.join(os.path.dirname(__file__), "..", "lib.sh")

def refuse(path):
    if not (path.startswith("/dev/disk") or path.startswith("/dev/rdisk")):
        return
    probe = subprocess.run(
        ["bash", "-c", '. "$1"; psbbn_disk_internal "$2"', "bash", lib_sh(), path],
        capture_output=True,
    )
    # Return code 1 is the only external-disk answer. Anything else refuses.
    if probe.returncode != 1:
        sys.stderr.write(f"sfdisk: refusing {path}\n")
        sys.exit(2)

def disk_sectors(path):
    info = plistlib.loads(subprocess.check_output(["diskutil", "info", "-plist", path]))
    size = int(info.get("TotalSize") or info.get("Size") or 0)
    return size // 512

def parse(text, total):
    start = 2048
    entries = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(",")
        if len(parts) < 3:
            sys.stderr.write(f"sfdisk: bad line: {line}\n")
            sys.exit(1)
        size = parts[1].strip()
        typ = int(parts[2].strip(), 16)
        if size == "":
            count = total - start
        else:
            if not size.endswith("MiB"):
                sys.stderr.write(f"sfdisk: size must be MiB or empty: {size}\n")
                sys.exit(1)
            count = int(size[:-3]) * 2048
        if start + count > total:
            sys.stderr.write("sfdisk: partitions do not fit in the image\n")
            sys.exit(1)
        entries.append((typ, start, count))
        start += count
    return entries

def main(argv):
    if len(argv) > 1 and argv[1] == "--psbbn-shim-ok":
        return 0
    if len(argv) != 2:
        sys.stderr.write("usage: sfdisk DEVICE\n")
        return 1
    path = argv[1]
    refuse(path)
    if path.startswith("/dev/"):
        total = disk_sectors(path)
    elif os.path.isfile(path):
        total = os.path.getsize(path) // 512
    else:
        sys.stderr.write(f"sfdisk: not a regular file: {path}\n")
        return 1
    entries = parse(sys.stdin.read(), total)
    blob = bytearray(512)
    for i, (typ, start, count) in enumerate(entries[:4]):
        off = 446 + i * 16
        blob[off + 4] = typ
        blob[off + 8:off + 12] = struct.pack("<I", start)
        blob[off + 12:off + 16] = struct.pack("<I", count)
    blob[510] = 0x55
    blob[511] = 0xAA
    if path.startswith("/dev/"):
        proc = subprocess.run(
            ["bash", "-c", '. "$1"; platform_elevate dd of="$2" bs=512 count=1 conv=notrunc', "bash", load_sh(), path],
            input=bytes(blob),
        )
        return proc.returncode
    with open(path, "r+b") as fh:
        fh.write(blob)
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv))
