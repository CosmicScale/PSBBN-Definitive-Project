#!/bin/bash
# pfsshell, built from the same source as the Linux PFS Shell (AKuHAK's ext2
# branch), formats EXT2 and EXT2SWAP inside mkpart. This wrapper refuses an
# internal disk and gets the drive back from Disk Arbitration first.
if [[ -t 0 ]]; then
    exec "$(cd "$(dirname "$0")" && pwd)/pfsshell" "$@"
fi
self=$0
while [[ -L "$self" ]]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self="$(cd "$(dirname "$self")" && pwd)/$link" ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)
# shellcheck disable=SC1091
. "$here/../../platform/load.sh"
cmds=$(cat)
device=$(printf '%s\n' "$cmds" | awk '/^device / {print $2; exit}')
if [[ -n "$device" ]] && psbbn_is_real_disk "$device" && psbbn_disk_internal "$device"; then
    printf '%s\n' "PFS Shell: refusing internal disk $device" >&2
    exit 2
fi
# macOS refuses the read-write open of the whole disk while Disk Arbitration
# has a volume of it mounted under /Volumes. pfsshell then prints
# "<device>: Resource busy" on stderr and exits before doing anything, so
# the script is safe to run again after evicting that mount.
errors=$(mktemp)
for attempt in 1 2 3 4 5 6; do
    [[ -n "$device" ]] && psbbn_evict_automounts "$device"
    output=$(printf '%s\n' "$cmds" | "$here/pfsshell" "$@" 2> "$errors")
    status=$?
    if [[ -n "$device" ]] && psbbn_pfs_open_busy "$device" "$output"$'\n'"$(cat "$errors")"; then
        sleep "${PSBBN_DA_SETTLE:-1}"
        continue
    fi
    break
done
printf '%s\n' "$output"
cat "$errors" >&2
rm -f "${errors:?}"
if [[ "$status" -gt 128 ]]; then
    printf '%s\n' "PFS Shell: pfsshell died with signal $((status - 128)); commands after the last prompt did not run." >&2
fi
if [[ "$status" -ne 0 ]]; then
    exit "$status"
fi
if [[ -n "$device" ]] && printf '%s\n' "$output" | grep -F -q "$device: "; then
    # The device could not be opened.
    exit 1
fi
exit 0
